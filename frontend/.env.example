# Copy to .env.local if you need to override anything. Never commit real values.

# Where the Vite dev server forwards /api/* requests (dev only).
VITE_PROXY_TARGET=http://localhost:8080

# Production only: absolute URL of the deployed backend, no trailing slash.
# Leave empty in development so requests stay same-origin and go through the proxy.
# Requires CORS to allow your frontend origin on the backend (see FRONTEND_NOTES.md).
VITE_API_BASE_URL=
