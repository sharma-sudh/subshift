# Copy this file to backend/.env and replace the placeholders. Never commit .env.
DB_NAME=subshift_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# At least 32 characters. The app refuses to start with the placeholder.
JWT_SECRET=change-me

# Base64 of exactly 32 random bytes. The app refuses to start with the placeholder.
TOKEN_ENCRYPTION_KEY=change-me

# Optional: only needed for the Gmail and Gemini features
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=

# Optional: Outlook sign-in (Azure app registration, delegated permissions: Mail.Read and offline_access)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:8080/api/mail/outlook/callback
# MICROSOFT_TENANT=common

# Optional: alert emails over SMTP. Gmail example: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com,
# MAIL_PASSWORD=<a Google app password>. Any SMTP service works (Brevo, Mailtrap, ...). Port 587 with STARTTLS.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=SubShift <alerts@example.com>   (defaults to MAIL_USERNAME)

# Optional overrides (defaults shown)
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback
# FRONTEND_URL=http://localhost:5173
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest
# CORS_ALLOWED_ORIGINS=http://localhost:5173
