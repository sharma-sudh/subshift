# Copy this file to ".env" in the repository root and replace the placeholders. Never commit ".env".
# Used by docker-compose.yml only (the app run without Docker reads backend/.env instead).
DOCKERHUB_USER=sudh14
DB_PASSWORD=change-me
# At least 32 characters:  openssl rand -base64 48
JWT_SECRET=change-me
# Base64 of exactly 32 random bytes:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me

# Optional (Gmail and Gemini features are switched off while these are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
